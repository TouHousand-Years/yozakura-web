[
  {
    "id": "marisa_second_story",
    "title": "第七章 折樱未解",
    "scope": {
      "kind": "characters",
      "characterIds": [
        "marisa"
      ]
    },
    "intro": "老是被追着像什么话？区区灵梦而已，如果被打败了，可不要哭鼻子哦！解决了灵梦之后，要带着她去把问题学生抓回来……等一下，说白了，你就是很喜欢她吧。",
    "sceneImage": "public/art/scenes/locations/square.bmp",
    "stages": [
      {
        "id": "square",
        "title": "广场相遇",
        "locationId": "square",
        "start": "square_intro"
      },
      {
        "id": "archives",
        "title": "学生会查档",
        "locationId": "student_union",
        "start": "union_intro"
      },
      {
        "id": "blossom",
        "title": "取一枝樱花",
        "locationId": "park",
        "start": "park_intro"
      },
      {
        "id": "offering",
        "title": "庭院献花",
        "locationId": "old_school",
        "start": "courtyard_intro"
      }
    ],
    "flow": {
      "start": "square_intro",
      "nodes": [
        {
          "id": "square_intro",
          "title": "广场",
          "kind": "story",
          "sceneImage": "public/art/scenes/locations/square.bmp",
          "text": "广场，但其实没有人愿意在这里停留，少女们更喜欢在阴凉一点儿的地方说悄悄话。",
          "next": {
            "kind": "node",
            "id": "caught"
          }
        },
        {
          "id": "caught",
          "title": "逮着了",
          "kind": "choice",
          "sceneImage": "public/art/scenes/locations/square.bmp",
          "text": "“魔！理！沙！又给我添麻烦……”\n\n你跑了一路，还是被她逮住了。",
          "choices": [
            {
              "id": "reply",
              "text": "没甩开啊……",
              "next": {
                "kind": "node",
                "id": "duel"
              }
            }
          ]
        },
        {
          "id": "duel",
          "title": "姐妹对决？",
          "kind": "choice",
          "sceneImage": "public/art/scenes/locations/square.bmp",
          "text": "“老实点，把你押回去我还有工作。”\n\n这家伙仍然像平常那样不可一世，你有些发虚，毕竟你从来没赢过……",
          "choices": [
            {
              "id": "face",
              "text": "“等等！”",
              "next": {
                "kind": "node",
                "id": "intruder"
              }
            }
          ]
        },
        {
          "id": "intruder",
          "title": "不速之客",
          "kind": "choice",
          "sceneImage": "public/art/scenes/locations/square.bmp",
          "text": "你发现一个从背后靠近她的影子，没想太多，直接扑倒了她……",
          "choices": [
            {
              "id": "protect",
              "text": "“趴下！”",
              "next": {
                "kind": "node",
                "id": "shadow_battle"
              }
            }
          ]
        },
        {
          "id": "shadow_battle",
          "title": "广场上的怪物",
          "kind": "battle",
          "sceneImage": "public/art/scenes/locations/square.bmp",
          "encounter": {
            "kind": "enemy_pool",
            "enemyIds": [
              "running_ninomiya"
            ],
            "rewards": []
          },
          "onVictory": {
            "kind": "node",
            "id": "team"
          }
        },
        {
          "id": "team",
          "title": "组队",
          "kind": "choice",
          "sceneImage": "public/art/scenes/locations/square.bmp",
          "text": "你们搞定了那个怪物，她少有地红着脸对你说谢谢：\n\n“那就仅限今晚一起，下不为例！”\n\n其实她看起来还挺高兴的……\n\n“先去学生会查一下资料吧。”她说。",
          "choices": [
            {
              "id": "together",
              "text": "“那就一起吧！”",
              "next": {
                "kind": "end",
                "id": "to_archives"
              }
            }
          ]
        },
        {
          "id": "union_intro",
          "title": "学生会大楼",
          "kind": "story",
          "sceneImage": "public/art/scenes/locations/student_union.bmp",
          "text": "学生会大楼，不光让少女们憧憬，也让少女们敬畏。\n\n在夜间尤其如此……“她”像是醒着一样。",
          "next": {
            "kind": "node",
            "id": "key"
          }
        },
        {
          "id": "key",
          "title": "在门前",
          "kind": "choice",
          "sceneImage": "public/art/scenes/locations/student_union.bmp",
          "text": "她有学生会大楼的钥匙，你难得堂堂正正地在晚上来到这里，她警告你：\n\n“别乱翻东西。”",
          "choices": [
            {
              "id": "reply",
              "text": "总有一天，我也要成为这里的一员",
              "next": {
                "kind": "node",
                "id": "chat"
              }
            }
          ]
        },
        {
          "id": "chat",
          "title": "闲聊",
          "kind": "choice",
          "sceneImage": "public/art/scenes/locations/student_union.bmp",
          "text": "档案室里整整齐齐码着校园内灵异事件的记录与线索，既有还没有破解的，也有已经被查明真相的。\n\n“灵梦，你会成为下一任学生会长吗？”\n\n你知道学生会的规矩，而灵梦目前解决的比你要多。\n\n“没那闲工夫。”她回答。",
          "choices": [
            {
              "id": "read",
              "text": "继续翻看旧校舍的记录",
              "next": {
                "kind": "node",
                "id": "record"
              }
            }
          ]
        },
        {
          "id": "record",
          "title": "殉情",
          "kind": "choice",
          "sceneImage": "public/art/scenes/locations/student_union.bmp",
          "text": "关于旧校舍的记录有整整一本，多亏了学生会前辈们的归档，你们很快找到了信息。当年的报道写着：“两名学生的尸体于中庭樱花树下被发现，此前有很多同学声称她们有很多亲密举动……”",
          "choices": [
            {
              "id": "tree",
              "text": "“樱花树？”",
              "next": {
                "kind": "node",
                "id": "missing_tree"
              }
            }
          ]
        },
        {
          "id": "missing_tree",
          "title": "树没了",
          "kind": "choice",
          "sceneImage": "public/art/scenes/locations/student_union.bmp",
          "text": "你们继续往下看，发现报告里，那棵樱花树后来被砍了，可能是出于隐瞒和不吉利的原因。\n\n你刚想说出自己的想法时，灵梦先一步说：\n\n“我觉得，去折一枝樱花来怎么样？”",
          "choices": [
            {
              "id": "agree",
              "text": "“我们想到一块去了。”",
              "next": {
                "kind": "end",
                "id": "to_blossom"
              }
            }
          ]
        },
        {
          "id": "park_intro",
          "title": "樱花树下",
          "kind": "story",
          "sceneImage": "public/art/scenes/locations/park.bmp",
          "text": "不知道为什么，你感到在樱花树下的每一刻……都是永恒的。\n\n真的，真的停住了……",
          "next": {
            "kind": "node",
            "id": "still_blooming"
          }
        },
        {
          "id": "still_blooming",
          "title": "定格",
          "kind": "choice",
          "sceneImage": "public/art/scenes/locations/park.bmp",
          "text": "花期早就过了，花瓣也在飘落……不过你感觉樱花是无穷无尽的，就好像定格在了某一刻似的。\n\n仿佛就是在等人一样。\n\n“这种怪象难道也是这桩陈年旧事的影响吗？”",
          "choices": [
            {
              "id": "approach",
              "text": "“……打扰了。”",
              "next": {
                "kind": "node",
                "id": "branch"
              }
            }
          ]
        },
        {
          "id": "branch",
          "title": "折枝",
          "kind": "choice",
          "sceneImage": "public/art/scenes/locations/park.bmp",
          "text": "灵梦挑了一枝，折了下来。\n\n别的树枝还是自顾自地撒着撒不完的花瓣。\n\n“如果让她们看了这花，会不会她们就愿意安息成佛了呢？”",
          "choices": [
            {
              "id": "take",
              "text": "“多谢。”",
              "next": {
                "kind": "node",
                "id": "shared_dream"
              }
            }
          ]
        },
        {
          "id": "shared_dream",
          "title": "梦",
          "kind": "choice",
          "sceneImage": "public/art/scenes/locations/park.bmp",
          "text": "望着折下来的枝条，灵梦对你说出她的怪梦，关于无尽的樱花下，望着恋人的梦。而你听了，对她说：“我也一样”。\n\n原来你们最近也做了相似的梦。\n\n或许，这就是你们今夜相会的原因，这并非偶然。",
          "choices": [
            {
              "id": "return",
              "text": "“且行且珍惜。”",
              "next": {
                "kind": "end",
                "id": "to_offering"
              }
            }
          ]
        },
        {
          "id": "courtyard_intro",
          "title": "庭院",
          "kind": "story",
          "sceneImage": "public/art/scenes/locations/old_school.bmp",
          "text": "这里荒草丛生，看上去荒废已久，路灯也是暗的。院子中央有一架长椅，高高的草叶在石板路两侧，像是在夹道欢迎你们。",
          "next": {
            "kind": "node",
            "id": "offering"
          }
        },
        {
          "id": "offering",
          "title": "祭品",
          "kind": "choice",
          "sceneImage": "public/art/scenes/locations/old_school.bmp",
          "text": "你们带着花枝来到旧校舍庭院，这里还是一样的寂静。\n\n你们想到了梦中樱花飞舞的样子，然而现在空空荡荡，只有一派恐怖之色……\n\n那个实际上刻满了字的树桩出现在你们面前。",
          "choices": [
            {
              "id": "offer",
              "text": "献上枝条，然后等待……",
              "next": {
                "kind": "node",
                "id": "bench"
              }
            }
          ]
        },
        {
          "id": "bench",
          "title": "长椅",
          "kind": "choice",
          "sceneImage": "public/art/scenes/locations/old_school.bmp",
          "text": "“结束了吗？”你问，这种事情上，你觉得灵梦的直觉更可靠。\n\n“不……好像还没有。”她说。周遭的气温好像低了几度，那可怜的一枝樱花确实在暗夜里微微发着光，但没什么特别的事情发生……好像还有什么事情被忽视了。\n\n你们在院中的长椅上坐下来。一路走来你忽然明白，她关心的并不是你究竟赢不赢得了她——这点想法让你没来由地轻松了不少。",
          "choices": [
            {
              "id": "gift",
              "text": "把准备好的礼物送给灵梦",
              "next": {
                "kind": "node",
                "id": "gift"
              },
              "requires": {
                "kind": "task_completed",
                "taskId": "marisa_gift"
              }
            },
            {
              "id": "finish",
              "text": "再等等吧。",
              "next": {
                "kind": "end",
                "id": "unfinished"
              },
              "effects": [
                {
                  "kind": "experience",
                  "amount": 100
                },
                {
                  "kind": "money",
                  "amount": 15
                },
                {
                  "kind": "anomaly",
                  "amount": -10
                }
              ]
            }
          ]
        },
        {
          "id": "gift",
          "title": "礼物",
          "kind": "choice",
          "sceneImage": "public/art/scenes/locations/old_school.bmp",
          "text": "你摸了摸怀里。那对买一赠一的小玩意，给她的那一份还好好包着。\n\n本来想等真正赢过她那天再给。但是……",
          "choices": [
            {
              "id": "give",
              "text": "现在不是计较那些输赢的时候",
              "next": {
                "kind": "node",
                "id": "reaction"
              }
            }
          ]
        },
        {
          "id": "reaction",
          "title": "给我的？",
          "kind": "choice",
          "sceneImage": "public/art/scenes/locations/old_school.bmp",
          "text": "“给，给我的吗？”\n\n“是，是啊，顺手买的，别想太多。”",
          "choices": [
            {
              "id": "compliment",
              "text": "“但确实很适合你。”",
              "next": {
                "kind": "end",
                "id": "gift_done"
              },
              "effects": [
                {
                  "kind": "experience",
                  "amount": 100
                },
                {
                  "kind": "money",
                  "amount": 15
                },
                {
                  "kind": "anomaly",
                  "amount": -10
                }
              ]
            }
          ]
        }
      ],
      "endings": [
        {
          "id": "to_archives",
          "title": "去学生会查档",
          "text": "你和灵梦暂时联手，动身去学生会大楼查找旧校舍的资料。",
          "outcome": "stage_completed",
          "completes": false,
          "sceneImage": "public/art/scenes/locations/square.bmp",
          "nextStage": "archives"
        },
        {
          "id": "to_blossom",
          "title": "取一枝樱花",
          "text": "旧校舍的樱花树已经被砍掉。你们决定去公园折一枝樱花，带回旧校舍。",
          "outcome": "stage_completed",
          "completes": false,
          "sceneImage": "public/art/scenes/locations/student_union.bmp",
          "nextStage": "blossom"
        },
        {
          "id": "to_offering",
          "title": "返回旧校舍",
          "text": "花枝已经到手。你和灵梦带着它回到旧校舍庭院。",
          "outcome": "stage_completed",
          "completes": false,
          "sceneImage": "public/art/scenes/locations/park.bmp",
          "nextStage": "offering"
        },
        {
          "id": "unfinished",
          "title": "结束……？",
          "text": "花枝在树桩前微微发着光。你和灵梦并肩坐在长椅上。",
          "outcome": "completed",
          "completes": true,
          "sceneImage": "public/art/scenes/locations/old_school.bmp"
        },
        {
          "id": "gift_done",
          "title": "礼物送到了",
          "text": "你把那份礼物交给灵梦，两个人仍并肩坐在长椅上。",
          "outcome": "completed",
          "completes": true,
          "sceneImage": "public/art/scenes/locations/old_school.bmp"
        }
      ]
    }
  }
]
