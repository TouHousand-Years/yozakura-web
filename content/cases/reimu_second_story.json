        },
        {
          "id": "shadow_after",
          "title": "斥责减弱",
          "kind": "choice",
          "sceneImage": "public/art/scenes/locations/old_school.bmp",
          "text": "当男人的阴影也被驱散，那股一直笼罩在空间中，令人窒息的压迫感终于消散了。你耳边的嘈杂声音也逐渐减弱。",
          "choices": [
            {
              "id": "next",
