    "flow": {
      "start": "chapel_intro",
      "nodes": [
        {
          "id": "chapel_intro",
          "title": "礼堂",
          "kind": "story",
          "sceneImage": "public/art/scenes/locations/auditorium.bmp",
          "text": "因为是教会女校，所以会有一个小教堂，但唱圣歌的会有佛教徒和神道教徒与无神论者……还会有什么呢？",
          "next": {
            "kind": "node",
            "id": "request"
          }
        },
        {
          "id": "request",
          "title": "请求",
          "kind": "choice",
          "sceneImage": "public/art/scenes/locations/auditorium.bmp",
          "text": "有一位修女请求你帮她打扫一下地下室，因为今天只有她值班，但是她实在怕黑。",
          "choices": [
            {
              "id": "help",
              "text": "很荣幸能帮到您",
              "next": {
                "kind": "node",
                "id": "apparition"
              }
            },
            {
              "id": "busy",
              "text": "我现在有些忙……",
              "next": {
                "kind": "end",
                "id": "left"
              }
            }
          ]
        },
        {
          "id": "apparition",
          "title": "什么鬼",
          "kind": "choice",
          "sceneImage": "public/art/scenes/locations/auditorium.bmp",
          "text": "你打扫房间的时候，墙边的人体模型突然动了起来，挡住了通向楼梯的路。",
          "choices": [
            {
              "id": "fight",
              "text": "什么鬼？",
              "next": {
                "kind": "node",
                "id": "basement_battle"
              }
            }
          ]
        },
        {
          "id": "basement_battle",
          "kind": "battle",
          "title": "地下室的异物",
          "sceneImage": "public/art/scenes/locations/auditorium.bmp",
          "encounter": {
            "kind": "battle",
            "battleId": "aya_basement_apparition"
          },
          "onVictory": {
            "kind": "node",
            "id": "relief"
          }
        },
        {
          "id": "relief",
          "title": "虚惊一场",
          "kind": "choice",
          "sceneImage": "public/art/scenes/locations/auditorium.bmp",
          "text": "人体模型终于不动了。它的行动方式真是毫无征兆。你不打算把这事儿告诉修女——她本来就已经很怕黑了。",
          "choices": [
            {
              "id": "finish",
              "text": "还好打扫完了",
              "next": {
                "kind": "end",
                "id": "done"
              }
            }
          ]
        }
      ],
      "endings": [
        {
          "id": "left",
          "title": "暂时帮不上忙",
          "text": "你向修女告辞，等有空再来。",
